<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FirestickCleanup</RootNamespace>
    <AssemblyName>FirestickCleanup</AssemblyName>
    <AssemblyTitle>Firestick Cleanup Tool</AssemblyTitle>
    <Product>Firestick Cleanup Tool</Product>
    <Copyright>MIT License</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <!-- Bundled ADB and the shared config files are copied next to the exe. -->
  <ItemGroup>
    <Content Include="..\adb\**\*.*" Link="adb\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\common\*.conf" Link="common\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
